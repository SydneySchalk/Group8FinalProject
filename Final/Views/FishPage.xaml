<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Final.Views.FishPage"
             Title="Fish List">
	<StackLayout>
		<!-- Search Bar -->
		<SearchBar Placeholder="Search by name, season, time, or weather"
                   Text="{Binding SearchText}"
                   TextChanged="OnSearchTextChanged" />

		<!-- Fish List -->
		<ListView x:Name="FishListView"
                  ItemsSource="{Binding FilteredFishGrouped}"
                  IsGroupingEnabled="True"
                  GroupDisplayBinding="{Binding Key}">
			<ListView.ItemTemplate>
				<DataTemplate>
					<ViewCell>
						<StackLayout Padding="10" Spacing="5">
							<Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
							<StackLayout Padding="10" Spacing="2">
								<Label Text="{Binding Season}" FontSize="16" TextColor="Gray" />
								<Label Text="{Binding Weather}" FontSize="16" TextColor="Gray" />
								<Label Text="{Binding Time}" FontSize="16" TextColor="Gray" />
								<Image Source="{Binding Image}" HeightRequest="100" />
								<Label Text="{Binding Obtained, Converter={StaticResource BoolToObtainedConverter}}" FontSize="16" TextColor="Gray" />
							</StackLayout>
						</StackLayout>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</StackLayout>
</ContentPage>