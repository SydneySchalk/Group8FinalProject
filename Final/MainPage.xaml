<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Final.MainPage">

    <VerticalStackLayout Padding="10">
        <Label Text="Fishing Guide" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <CollectionView x:Name="FishCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Fish.Name}" FontAttributes="Bold" FontSize="18"/>
                        <Label Text="{Binding LocationsDisplay}" FontSize="14" TextColor="Gray"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
