<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Final.MainPage">

    <StackLayout Padding="10">
        <!-- Button to Add Fish -->
        <Button Text="Add Fish" Clicked="OnAddFishClicked" />

        <!-- Button to Add Location -->
        <Button Text="Add Location" Clicked="OnAddLocationClicked" />

        <!-- Button to Associate Fish with Location -->
        <Button Text="Associate Fish with Location" Clicked="OnAssociateFishWithLocationClicked" />

        <!-- Button to View Fish Locations -->
        <Button Text="View Fish Locations" Clicked="OnViewFishLocationsClicked" />

        <!-- CollectionView to display the list of fish and locations -->
        <CollectionView x:Name="FishCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Fish.Name}" FontSize="20" />
                        <Label Text="{Binding LocationsDisplay}" FontSize="16" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
